# =============================================================================
#  SEGREDOS. Copie para .env  ->  cp .env.example .env
#  .env esta no .gitignore. Nao commite este arquivo preenchido.
#  Qualquer valor em config/*.yaml pode referenciar estas variaveis com ${NOME}.
# =============================================================================

# Dados sensiveis referenciados no profile.yaml
CPF=000.000.000-00

# --- Contas dos portais de carreira -----------------------------------------
# Crie a conta manualmente no site UMA VEZ, depois coloque aqui.

# Gupy (usada por Itau, Zamp e a maioria das empresas BR)
GUPY_EMAIL=seu.email@exemplo.com
GUPY_PASSWORD=sua-senha

# NVIDIA (Workday)
NVIDIA_EMAIL=seu.email@exemplo.com
NVIDIA_PASSWORD=sua-senha

# Microsoft (conta Microsoft)
MICROSOFT_EMAIL=seu.email@exemplo.com
MICROSOFT_PASSWORD=sua-senha

# Google (conta Google - tem 2FA; prefira logar manualmente uma vez com
# `candidate login google` e deixar o perfil persistente guardar a sessao)
GOOGLE_EMAIL=seu.email@exemplo.com
GOOGLE_PASSWORD=

# Greenhouse/Lever/Ashby normalmente nao exigem login.
